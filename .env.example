# Copy to .env and fill in.

# ════════ Before stage: meetpipe (pre-meeting context) ════════
# ── Team apps: set up ONCE by the app owner, then share these lines with the team ──
# Google OAuth client (Desktop app) with Gmail + Drive APIs enabled. See README → "Google (one-time)".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Read-only GitHub App. Filled in automatically by: uv run run.py setup-github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=

# ── Per user: nothing to fill in. Run `uv run run.py connect` and click Connect. ──
# Tokens are stored in ~/.meetpipe (override with MEETPIPE_TOKEN_DIR).

# Slack bot (`run.py slack-bot`): Socket Mode, so it runs from a laptop. Only ONE process per Slack app
# should listen at a time, or mentions get split randomly between them.
SLACK_APP_TOKEN=
# SLACK_BOT_TOKEN is shared with the After stage (see below).

# Which local CLI summarizes: claude | codex
LLM=claude
# Only needed if auto-detection fails:
# CLAUDE_BIN=/path/to/claude
# CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex

# Optional tuning
# TRANSCRIPTS_DIR=transcripts
# TRANSCRIPT_SENDERS=meet-recordings-noreply@google.com,gemini-notes@google.com,no-reply@zoom.us,no-reply@otter.ai,fred@fireflies.ai
# DRIVE_MAX_FILES=300
# CONTEXT_CHAR_BUDGET=350000

# ════════ After stage: after/ (post-meeting agent) ════════
# Anything left blank runs in dry-run / fallback mode.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Recall.ai (https://www.recall.ai) - bot joins Zoom/Meet/Teams, free meeting-caption transcripts
RECALL_API_KEY=
RECALL_REGION=us-west-2

# GitHub issues for engineering tasks (needs Issues: write). Note: if set, meetpipe also uses it
# for reading instead of the GitHub App login.
GITHUB_TOKEN=
GITHUB_REPO=taufiqhusada/MeetingPipelines
GITHUB_ASSIGN=0

# Slack (waiting on Slack teammate)
SLACK_BOT_TOKEN=
SLACK_CHANNEL=test-bot-features
# Testing: send every Slack message to this one username instead
SLACK_ONLY_TO=

# Google Calendar: run `python -m after.google_setup` after placing after/data/google_credentials.json
TIMEZONE=America/Los_Angeles
# Google Meet captions label the TranscripTonic user "You"; use this name instead
TRANSCRIPT_SELF_NAME=

# Optional for Search (anonymous works). Required for Act ("Run via Darwin"): an API key from app.darwin.so
# that Darwin has added to the Act pilot allowlist.
DARWIN_API_KEY=

# 1 = nothing leaves the machine (everything is logged to the outbox). Set 0 to go live.
DRY_RUN=1
